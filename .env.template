
# ── Gateway ──────────────────────────────────────────────────────────────────

EXTERNAL_HOSTNAME=http://localhost:8000
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
EDC_GATEWAY_POSTGRES_USER=postgres
EDC_GATEWAY_POSTGRES_SECRET=
EDC_GATEWAY_POSTGRES_DB=edc-gateway

# ── OIDC / Keycloak ───────────────────────────────────────────────────────────
# OIDC_JWKS_URL points to Keycloak directly (internal docker hostname) so the
# api container can reach it. OIDC_ISSUER must match the `iss` claim in the
# JWT — that claim reflects the public hostname (via nginx), not the internal one.
KC_EXTERNAL_HOSTNAME=keycloak:8080
KC_REALM=edc
KC_CLIENT_ID=frontend
OIDC_ISSUER=https://${KC_EXTERNAL_HOSTNAME}/auth/realms/${KC_REALM}
OIDC_JWKS_URL=${OIDC_ISSUER}/protocol/openid-connect/certs
OIDC_AUDIENCE=                   # optional — leave empty to skip audience check
OIDC_TIMEOUT=10.0

# ── Keycloak admin ────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=

# ── Kubernetes ────────────────────────────────────────────────────────────────
K8S_NAMESPACE=edc-gateway
K8S_IN_CLUSTER=false             # true inside Kubernetes, false for local dev (uses ~/.kube/config)
K8S_KUBE_CONIG_PATH=~/.kube/config

# ── Argo Workflows ────────────────────────────────────────────────────────────
ARGO_SERVER_URL=https://argo.example.com
ARGO_NAMESPACE=argo
ARGO_WORKFLOW_SA=argo
ARGO_CONSUME_TEMPLATE=consume-asset
ARGO_CREATE_ASSET_TEMPLATE=create-asset
ARGO_TIMEOUT=30.0
ARGO_VERIFY_SSL=true             # set false for self-signed Argo server certificates
