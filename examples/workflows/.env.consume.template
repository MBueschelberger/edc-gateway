
# =============================================================================
# General
# -----------------------------------------------------------------------------

# catena-X
# DID_BASE=did:web:portal-backend.beta.cofinity-x.com:api:administration:staticdata:did
# D4E
DID_BASE=did:web:wacholder.digital-twin.host

# Protocol version for DSP communication.
# Set to "true" to use the 2025-1 protocol variant (dataspace-protocol-http:2025-1).
# Default: false (uses dataspace-protocol-http)
USE_2025_1=false

# Assigner identity in the contract negotiation policy.
# Set to "true" to use PROVIDER_BPN as odrl:assigner.
# Set to "false" to use PROVIDER_DID as odrl:assigner.
# Default: false
# Catena-X
# USE_BPN=true
# D4E
USE_BPN=false

# Transfer process acquisition strategy.
# Set to "true" to query EDR entries filtered by contractAgreementId (async, with retry).
# Set to "false" to create a transfer process directly via POST /transferprocesses.
# Default: true
# Catena-X
# USE_EDRS=true
# D4E
USE_EDRS=false


# Contract Negotiation Router
# Catena-X
# CONTRACT_NEGOTATION_ROUTER=edrs
# D4E
CONTRACT_NEGOTATION_ROUTER=contractnegotiations

# Enable debug output (request payloads and API responses).
# Set to "true" to print all payloads and responses during execution.
# Default: false
DEBUG=true

# =============================================================================
# Consumer Connector (für Consumer-Script)
# -----------------------------------------------------------------------------


CONSUMER_BPN=
CONSUMER_URL=
CONSUMER_API_KEY=
CONSUMER_API_SUFFIX=

# do not change
CONSUMER_DSP_URL=${CONSUMER_URL}${CONSUMER_URL_SUFFIX}
CONSUMER_DID=${DID_BASE}:${CONSUMER_BPN}


# =============================================================================
# Provider Details (für Consumer-Script - Catalog Request)
# -----------------------------------------------------------------------------

PROVIDER_BPN=
PROVIDER_URL=
PROVIDER_URL_SUFFIX=

# do not change
PROVIDER_DID=${DID_BASE}:${PROVIDER_BPN}
PROVIDER_DSP_URL=${PROVIDER_URL}${PROVIDER_URL_SUFFIX}

# =============================================================================
# Certificates
# -----------------------------------------------------------------------------

# Cert Data
CLIENT_CERT_PATH=
CLIENT_CERT_PASSWORD=
