# EDC Gateway base URL
GATEWAY_URL=http://localhost:8000

# Keycloak — use password grant for interactive scripts, client_credentials for automation
KEYCLOAK_TOKEN_URL=http://localhost:8080/realms/dev/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=edc-gateway
KEYCLOAK_CLIENT_SECRET=your-client-secret

# Fill ONE of these:
# Option A: password grant (user login)
KEYCLOAK_USERNAME=admin@example.com
KEYCLOAK_PASSWORD=secret

# Option B: client_credentials (service account) — leave USERNAME/PASSWORD empty
# KEYCLOAK_USERNAME=
# KEYCLOAK_PASSWORD=

EDC_ID=...
PROVIDER_BPN=BPNL0...
PROVIDER_DSP_URL=https://...

# ── EDC registration (01_register_edc.py) ────────────────────────────────────

EDC_ID=catena-x-prod
EDC_DISPLAY_NAME=Catena-X Production
EDC_CONSUMER_URL=https://consumer-edc.example.com
EDC_PROVIDER_URL=https://provider-edc.example.com
EDC_BASE_DID=did:web:provider-edc.example.com
EDC_PROVIDER_BPN=BPNL000000000001


# Flags (default: use_2025_1=true, use_edrs=true, use_bpn=false)
EDC_USE_2025_1=true
EDC_USE_EDRS=true
EDC_USE_BPN=false
EDC_CONTRACT_NEGOTIATION_ROUTER=contractnegotiations

# API keys — written to K8s Secret, never stored in plaintext in PostgreSQL
EDC_CONSUMER_API_KEY=consumer-api-key-here
EDC_PROVIDER_API_KEY=provider-api-key-here

# BPN Discovery (optional — alle 5 Variablen weglassen wenn nicht benötigt)
EDC_BPN_DISCOVERY_AUTH_URL=https://portal-backend.beta.cofinity-x.com/api/token
EDC_BPN_DISCOVERY_HOST=https://portal-backend.beta.cofinity-x.com
EDC_BPN_DISCOVERY_ENDPOINT=/api/administration/connectors/discovery
EDC_BPN_DISCOVERY_CLIENT_ID=my-client-id
EDC_BPN_DISCOVERY_CLIENT_SECRET=my-client-secret


# ── Asset creation (05_create_asset.py) ──────────────────────────────────────

ASSET_NAME="PMDCo-conformant RDF knowledge graph for PA6GF30"
ASSET_PATH=https://dataportal.material-digital.de/dataset/203bde74-4e5f-4a74-a1d8-261e0f8ca84a/resource/00367f16-e55d-4d1d-ad2e-3b8e1518e2d8/download/material_data_pa6gf30_pmdco.ttl
CONSUMER_BPN=BPNL0....

# Optional
ASSET_DESCRIPTION="PMDCo-conformant RDF knowledge graph for PA6GF30, produced by applying pmdco-mapping-insert.sparql to the Fuseki triplestore loaded with material_data_test_pa6gf30.json. Material properties are represented as PMDCo quality entities linked to QUDT-typed measurement datums. This is the output of the Catena-X → PMDCo conversion pipeline."
ASSET_TYPE=text/turtle
FULL_POLICY=false

# Optional: OAuth2 data address (Option C)
# DATA_ADDRESS_BASE_URL=https://protected-api.example.com
# DATA_ADDRESS_NAME=protected-api

# Optional: OAuth2 credentials for the provider's data backend
# Leave EDC_OAUTH2_TOKEN_URL unset to skip this block entirely
# EDC_OAUTH2_TOKEN_URL=https://auth.example.com/oauth/token
# EDC_OAUTH2_CLIENT_ID=my-client-id
# EDC_OAUTH2_CLIENT_SECRET_KEY=my-client-secret
# EDC_OAUTH2_GRANT_TYPE=client_credentials

# Optional: mTLS client certificate
# Leave EDC_CLIENT_CERT_PATH unset to skip
# EDC_CLIENT_CERT_PATH=/certs/client.p12
# EDC_CLIENT_CERT_PASSWORD=cert-password